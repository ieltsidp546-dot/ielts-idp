# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ielts_idp?schema=public"

# Private S3 bucket configuration. Never make this bucket public.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="your-private-results-bucket"

# Set to a long random secret before deployment.
AUTH_SECRET="replace-with-a-long-random-secret"
APP_BASE_URL="http://localhost:3000"

# Bootstrap the single administrator with `npm run db:seed` (never commit .env)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-unique-password-at-least-14-characters"
